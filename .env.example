# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Neon Postgres connection string (get from your Neon project dashboard).
# Use the pooled connection string for the app; either works for migrations.
DATABASE_URL=postgres://user:password@ep-example-123456.region.aws.neon.tech/carvalue?sslmode=require

# Resend (https://resend.com) — used to send verification and password-reset
# emails. In sandbox mode, onboarding@resend.dev only delivers to your own
# account email; verify a domain in the Resend dashboard to send to others.
RESEND_API_KEY=re_example
RESEND_FROM_EMAIL="CarSpy NZ <onboarding@resend.dev>"

# Base URL used to build absolute links in emails (verify/reset links).
APP_URL=http://localhost:3000
